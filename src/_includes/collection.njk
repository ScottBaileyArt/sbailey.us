---
layout: base.njk
---
{# One template renders every collection page from its data file.
   Legacy image filenames contain spaces, so paths are encoded on output. #}
{%- macro workCaption(work) -%}
<em>{{ work.title }}</em><br>
{%- if work.venue %}{{ work.venue }}<br>
{%- else %}{{ work.medium }}{% if work.dimensions %}, {{ work.dimensions }}{% endif %}<br>
{%- endif %}{{ work.year }}
{%- endmacro %}
<h1 class="pageTitle"><span class="pageTitleNumber">c{{ number }}</span>{{ title }}</h1>
<main class="pageBody">
  {%- if statement %}
  <p class="bodyText">{{ statement }}</p>
  {%- endif %}
  {%- if exhibition_statement %}
  <p class="bodyText"><a href="/{{ page.fileSlug }}/statement/">Read Exhibition Statement</a></p>
  {%- endif %}
  <ul class="artworkGallery">
    {%- for work in works %}
    <li class="artwork">
      <a class="artworkLink" {% lightboxImageAttrs work.image %} data-pswp-caption="{{ workCaption(work) }}">{% thumbnailImage work.image, work.title %}</a>
      <p class="artworkCaption">{{ workCaption(work) }}</p>
    </li>
    {%- endfor %}
  </ul>
</main>
