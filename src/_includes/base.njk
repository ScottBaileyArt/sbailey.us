<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<title>{{ title }} &mdash; Scott Bailey</title>
<link href="/css/photoswipe.css" rel="stylesheet">
<link href="/css/sb.css" rel="stylesheet" type="text/css">
<style type="text/css">
/* Carried over from the old pages' inline blocks: these three rules are the
   only ones sb.css does not already provide. Without the base font rule,
   unclassed table cells (e.g. the timeline years) fall back to 16px Times. */
body, td, th {
	font-size: 12px;
	font-family: Arial, Helvetica, sans-serif;
}
.style3 { color: #8499A0; }
.whitetext { color: #FFF; }
</style>
</head>

<body>
<table width="120%" border="0" cellspacing="0" cellpadding="0">
  <tr>
    <td><table width="100%" border="0" cellspacing="0" cellpadding="0">
      <tr>
        <td width="59%" align="left" valign="top"><a href="/"><img src="/images/common/subLogo.gif" alt="Scott Bailey" width="320" height="68" border="0"></a></td>
        <td width="41%" align="right" valign="top" class="topLeftNav"><div align="left">
          <p>&nbsp;</p>
          <p><a href="/collections/" class="HREFnoDec">collections</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/bio/" class="HREFnoDec">bio</a>&nbsp;&nbsp;|&nbsp;&nbsp;<a href="/contact/" class="HREFnoDec">contact</a></p>
        </div></td>
      </tr>
    </table></td>
  </tr>
  <tr>
    <td><table width="1444" border="0" cellpadding="0" cellspacing="0">
      <tr>
        <td bgcolor="#C9D8DD" class="whitetext">2022</td>
        <td bgcolor="#C9D8DD" class="whitetext">2016</td>
        <td bgcolor="#C9D8DD" class="whitetext">&nbsp;</td>
        <td bgcolor="#C9D8DD" class="whitetext">2013</td>
        <td bgcolor="#C9D8DD">&nbsp;</td>
        <td bgcolor="#C9D8DD"><span class="whitetext">2009</span></td>
        <td valign="bottom" bgcolor="#C9D8DD" class="whitetext">WASHINGTON</td>
        <td valign="bottom" bgcolor="#C9D8DD"><div align="center"><span class="whitetext"> 2006</span></div></td>
        <td valign="bottom" bgcolor="#C9D8DD">&nbsp;</td>
        <td width="80" valign="bottom" bgcolor="#C9D8DD"><span class="whitetext">2004</span></td>
        <td valign="bottom" bgcolor="#C9D8DD" class="whitetext">EGYPT</td>
        <td valign="bottom" bgcolor="#C9D8DD"><span class="whitetext">2001</span></td>
        <td valign="bottom" bgcolor="#C9D8DD">&nbsp;</td>
        <td valign="bottom" bgcolor="#C9D8DD" class="whitetext">1998</td>
        <td valign="bottom" bgcolor="#C9D8DD" class="whitetext">COLORADO</td>
        <td valign="bottom" bgcolor="#C9D8DD"><span class="whitetext">1996</span></td>
        <td valign="bottom" bgcolor="#C9D8DD" class="whitetext">JAPAN</td>
        <td width="84" valign="bottom" bgcolor="#C9D8DD"><span class="whitetext">ITALY</span></td>
      </tr>
      {# Node markers and labels are generated from the collection data files,
         newest first. Adding a collection adds it to the timeline automatically
         rather than needing every page edited by hand. Column widths are the
         hand-tuned originals; the timeline is rebuilt in the responsive pass. #}
      {%- set navWidths = [72, 72, 72, 80, 96, 82, 82, 85, 79, 72, 86, 78, 77, 82, 82, 80, 82] %}
      <tr>
        {%- for item in collections.timelineCollections %}
        <td width="{{ navWidths[loop.index0] }}" valign="bottom" bgcolor="#EBF0F1"><a href="{{ item.url }}"><img src="/images/common/subNavNode.gif" alt="" width="60" height="10" border="0" align="middle"></a></td>
        {%- endfor %}
        <td valign="bottom" bgcolor="#EBF0F1">&nbsp;</td>
      </tr>
    </table></td>
  </tr>
  <tr>
    <td><table border="0" cellspacing="0" cellpadding="0">
      <tr>
        {%- for item in collections.timelineCollections %}
        <td width="{{ navWidths[loop.index0] }}" align="center" valign="top" class="NavCopy"><a href="{{ item.url }}" title="{{ item.data.title }}">c{{ item.data.number }}</a></td>
        {%- endfor %}
        <td width="83" align="center" valign="top" class="NavCopy">&nbsp;</td>
      </tr>
    </table></td>
  </tr>
</table>

{{ content | safe }}

<script type="module" src="/js/lightbox.js"></script>
</body>
</html>
