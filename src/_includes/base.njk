<!doctype html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ title }}{% if page.url != "/" %} &mdash; Scott Bailey{% endif %}</title>
<link href="/css/photoswipe.css" rel="stylesheet">
<link href="/css/sb.css" rel="stylesheet" type="text/css">
<style type="text/css">
/* Carried over from the old pages' inline blocks: these rules are the only
   ones sb.css does not already provide. Without the base font rule,
   unclassed table cells fall back to 16px Times. */
body, td, th {
	font-size: var(--text-size);
	font-family: Arial, Helvetica, sans-serif;
}
.style3 { color: #8499A0; }
</style>
</head>

<body{% if bodyClass %} class="{{ bodyClass }}"{% endif %}>
<header class="siteHeader">
  <a class="siteLogo" href="/"><img src="/images/common/logo.png" alt="Scott Bailey" width="222" height="32"></a>
  <nav class="siteNav" aria-label="Main">
    <a href="/collections/">collections</a><span aria-hidden="true">|</span><a href="/bio/">bio</a><span aria-hidden="true">|</span><a href="/contact/">contact</a>
  </nav>
</header>

{%- if not hideTimeline %}
{#- The timeline: one column per collection, newest first, generated from the
    collection data files, so adding a collection adds it here. Each column
    has an optional label above it (a year or a place) from the collection's
    timeline_label field. The last column has no collection; it carries the
    ITALY label, the period before the first collection. On narrow screens
    the strip scrolls sideways (see sb.css). #}
<div class="timelineWrap">
  <nav class="timeline" aria-label="Collections by year">
    <ol class="timelineTrack">
      {%- for item in collections.timelineCollections %}
      <li class="timelineColumn">
        <span class="timelineLabel"><span>{{ item.data.timeline_label }}</span></span>
        <a class="timelineLink" href="{{ item.url }}" title="{{ item.data.title }}"
          {%- if page.url.startsWith(item.url) %} aria-current="page"{% endif %}>
          <span class="timelineNode"></span>c{{ item.data.number }}
        </a>
      </li>
      {%- endfor %}
      <li class="timelineColumn timelineColumn--end">
        <span class="timelineLabel"><span>ITALY</span></span>
        <span class="timelineNode timelineNode--empty"></span>
      </li>
    </ol>
  </nav>
</div>
<script>
  (() => {
    const strip = document.querySelector(".timeline");
    // When the timeline scrolls sideways, start it with the current
    // collection centred in view, rather than always at the newest.
    const current = strip.querySelector("[aria-current]");
    if (current) {
      const offset = current.getBoundingClientRect().left - strip.getBoundingClientRect().left;
      strip.scrollLeft += offset - (strip.clientWidth - current.offsetWidth) / 2;
    }
    // Show the fade at each edge (sb.css) while there's more to scroll to
    // that way.
    const update = () => {
      strip.parentElement.classList.toggle("hasLess", strip.scrollLeft > 1);
      strip.parentElement.classList.toggle(
        "hasMore", strip.scrollLeft + strip.clientWidth < strip.scrollWidth - 1);
    };
    strip.addEventListener("scroll", update, { passive: true });
    window.addEventListener("resize", update);
    update();
  })();
</script>
{%- endif %}

{{ content | safe }}

<script type="module" src="/js/lightbox.js"></script>
</body>
</html>
