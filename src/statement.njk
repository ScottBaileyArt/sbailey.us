---
layout: base.njk
pagination:
  data: collections.statements
  size: 1
  alias: entry
permalink: "/{{ entry.page.fileSlug }}/statement/"
eleventyComputed:
  title: "{{ entry.data.title }} — Exhibition Statement"
---
<h1 class="pageTitle"><span class="pageTitleNumber">c{{ entry.data.number }}</span>{{ entry.data.title }}</h1>
<main class="pageBody">
  {%- for paragraph in entry.data.exhibition_statement %}
  <p class="bodyText">{{ paragraph }}</p>
  {%- endfor %}
  <p class="bodyText"><a href="{{ entry.url }}">&larr; Back to {{ entry.data.title }}</a></p>
</main>
